{
  "name": "academia-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p server/tsconfig.json && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts",
    "check:api": "tsc -p server/tsconfig.json",
    "test:api": "tsx --test server/auth.test.ts",
    "test:edge": "node --test scripts/admin-users.test.mjs",
    "test:finance": "tsx --test scripts/financial-status.test.ts scripts/finance-reports.test.ts",
    "prepare:vercel": "node scripts/prepare-vercel.mjs",
    "test:pwa": "node --test scripts/pwa.test.mjs",
    "test:load": "node scripts/load-read.mjs",
    "test:pix": "tsx --test scripts/pix.test.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@supabase/supabase-js": "2.119.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.72.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
